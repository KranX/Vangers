# Exercise the actual developer deployment helper, without a Windows toolchain.
STRING(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
SET(stage "${TEST_ROOT}/${HELPER}-${nonce}")
FILE(MAKE_DIRECTORY "${stage}/build/src" "${stage}/game/locales/custom" "${stage}/stubs")
FILE(WRITE "${stage}/build/src/vangers.exe" "fixture executable")
FILE(WRITE "${stage}/game/locales/custom/keep.txt" "user-installed locale")
FILE(COPY "${LOCALES}" DESTINATION "${stage}/build/src")
FILE(WRITE "${stage}/ru-expected.txt" "НОВАЯ ИГРА")
IF(HELPER STREQUAL "msys2")
 # Only path conversion and DLL inspection are platform-specific. All deployment
 # logic runs unmodified, including paths containing spaces and repeated copies.
 FILE(WRITE "${stage}/stubs/cygpath" "#!/bin/sh\nshift; shift; printf '%s\\n' \"$1\"\n")
 FILE(WRITE "${stage}/stubs/ldd" "#!/bin/sh\nexit 0\n")
 FILE(CHMOD "${stage}/stubs/cygpath" "${stage}/stubs/ldd"
  PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
 SET(command "${CMAKE_COMMAND}" -E env "PATH=${stage}/stubs:$ENV{PATH}"
  "GAME_DIR=${stage}/game" "BUILD_DIR=${stage}/build" "MINGW_PREFIX=${stage}/empty"
  "${SHELL}" "${SOURCE_ROOT}/packaging/msys2/run-msys2.sh")
ELSE()
 SET(command "${SHELL}" -NoProfile -NonInteractive -File "${SOURCE_ROOT}/packaging/msvc/run-msvc.ps1"
  -GameDir "${stage}/game" -BuildDir "${stage}/build" -ClunkRoot "${stage}/empty"
  -FfmpegRoot "${stage}/empty" -VcpkgRoot "${stage}/empty" -NoRun)
ENDIF()
FOREACH(pass RANGE 1 2)
 EXECUTE_PROCESS(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
 IF(NOT result STREQUAL "0")
  MESSAGE(FATAL_ERROR "${HELPER} deployment: ${result}: ${stdout}\n${stderr}")
 ENDIF()
 FOREACH(locale en ru)
  FOREACH(file manifest.toml strings.toml)
   FILE(SHA256 "${LOCALES}/${locale}/${file}" expected)
   FILE(SHA256 "${stage}/game/locales/${locale}/${file}" copied)
   IF(NOT copied STREQUAL expected)
    MESSAGE(FATAL_ERROR "Deployment damaged ${locale}/${file}")
   ENDIF()
  ENDFOREACH()
 ENDFOREACH()
 IF(EXISTS "${stage}/game/locales/locales" OR NOT EXISTS "${stage}/game/locales/custom/keep.txt")
  MESSAGE(FATAL_ERROR "Redeployment nested catalogs or removed a user locale")
 ENDIF()
 # Load the deployed catalog through the real loader as well as checking bytes.
 EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "VANGERS_LOCALES=${stage}/game/locales"
  "${PROBE}" --installed ru "${stage}/ru-expected.txt" RESULT_VARIABLE result)
 IF(NOT result STREQUAL "0")
  MESSAGE(FATAL_ERROR "Deployed catalogs cannot be loaded")
 ENDIF()
ENDFOREACH()
FILE(WRITE "${stage}/build/src/vangers.exe" "must not be partially deployed")
FOREACH(file manifest.toml strings.toml)
 FILE(RENAME "${stage}/build/src/locales/en/${file}" "${stage}/build/src/locales/en/${file}.missing")
 EXECUTE_PROCESS(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
 IF(result STREQUAL "0")
  MESSAGE(FATAL_ERROR "Deployment accepted missing ${file}")
 ENDIF()
 FILE(READ "${stage}/game/vangers.exe" exe)
 IF(NOT exe STREQUAL "fixture executable")
  MESSAGE(FATAL_ERROR "Missing catalogs caused a partial executable deployment")
 ENDIF()
 FILE(RENAME "${stage}/build/src/locales/en/${file}.missing" "${stage}/build/src/locales/en/${file}")
ENDFOREACH()
