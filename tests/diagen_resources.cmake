FILE(MAKE_DIRECTORY "${TEST_ROOT}")
FOREACH(encoding legacy utf8 ids)
 FOREACH(language ru en)
  SET(dir "${TEST_ROOT}/${encoding}-${language}")
  FILE(MAKE_DIRECTORY "${dir}")
  EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" "${encoding}" "${language}"
   WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
  IF(NOT result STREQUAL "0")
   MESSAGE(FATAL_ERROR "Diagen source ${encoding}/${language}: ${result}: ${stdout}\n${stderr}")
  ENDIF()
  FILE(READ "${dir}/diagen_new.text" signature LIMIT 2 HEX)
  IF(NOT signature STREQUAL "4455")
   MESSAGE(FATAL_ERROR "Compiler did not mark UTF-8 archive")
  ENDIF()
  IF(language STREQUAL "ru")
   SET(archive diagen.text)
  ELSE()
   SET(archive diagen_eng.text)
  ENDIF()
  FILE(COPY_FILE "${dir}/diagen_new.text" "${dir}/${archive}")
  EXECUTE_PROCESS(COMMAND "${BINARY_PARSER}" "${encoding}" "${language}" compiled
   WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
  IF(NOT result STREQUAL "0")
   MESSAGE(FATAL_ERROR "Diagen packed ${encoding}/${language}: ${result}: ${stdout}\n${stderr}")
  ENDIF()
 ENDFOREACH()
ENDFOREACH()
FOREACH(mode invalid truncated signature count unterminated negative-length)
 FILE(MAKE_DIRECTORY "${TEST_ROOT}/${mode}")
 # Expected-fatal paths terminate with live models. Successful cases keep leak checking.
 EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
  "${BINARY_PARSER}" "${mode}" WORKING_DIRECTORY "${TEST_ROOT}/${mode}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
 IF(mode STREQUAL "invalid" OR mode STREQUAL "unterminated")
  SET(expected "Invalid Diagen text")
 ELSEIF(mode STREQUAL "signature")
  SET(expected "Unknown Diagen archive encoding")
 ELSEIF(mode STREQUAL "count")
  SET(expected "Invalid Diagen archive entry count")
 ELSE()
  SET(expected "Invalid Diagen archive entry length")
 ENDIF()
 STRING(FIND "${stderr}" "${expected}" diagnostic)
 IF(NOT result STREQUAL "1" OR diagnostic LESS 0)
  MESSAGE(FATAL_ERROR "Diagen malformed ${mode}: ${result}: ${stdout}\n${stderr}")
 ENDIF()
ENDFOREACH()
FILE(MAKE_DIRECTORY "${TEST_ROOT}/invalid-source")
EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
 "${SOURCE_PARSER}" invalid-source WORKING_DIRECTORY "${TEST_ROOT}/invalid-source"
 RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
STRING(FIND "${stderr}" "Invalid Diagen UTF-8 source" diagnostic)
STRING(FIND "${stderr}" "data/Inventory.text" context)
IF(NOT result STREQUAL "1" OR diagnostic LESS 0 OR context LESS 0)
 MESSAGE(FATAL_ERROR "Diagen invalid source: ${result}: ${stdout}\n${stderr}")
ENDIF()

FILE(MAKE_DIRECTORY "${TEST_ROOT}/empty-query")
EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" empty en
 WORKING_DIRECTORY "${TEST_ROOT}/empty-query" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
IF(NOT result STREQUAL "0")
 MESSAGE(FATAL_ERROR "Diagen empty source: ${result}: ${stdout}\n${stderr}")
ENDIF()
FILE(COPY_FILE "${TEST_ROOT}/empty-query/diagen_new.text" "${TEST_ROOT}/empty-query/diagen_eng.text")
EXECUTE_PROCESS(COMMAND "${BINARY_PARSER}" empty en compiled
 WORKING_DIRECTORY "${TEST_ROOT}/empty-query" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
IF(NOT result STREQUAL "0")
 MESSAGE(FATAL_ERROR "Diagen empty packed query: ${result}: ${stdout}\n${stderr}")
ENDIF()

FOREACH(mode bad-id-empty bad-id-colon bad-id-unicode bad-id-reserved bad-id-length duplicate-id unknown-link unkeyed-link saved-id saved-index ambiguous-save)
 FILE(MAKE_DIRECTORY "${TEST_ROOT}/${mode}")
 EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
  "${BINARY_PARSER}" "${mode}" WORKING_DIRECTORY "${TEST_ROOT}/${mode}"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
 IF(mode STREQUAL "duplicate-id")
  SET(expected "Duplicate Diagen topic ID")
 ELSEIF(mode STREQUAL "unknown-link")
  SET(expected "Unknown Diagen linked topic ID")
 ELSEIF(mode STREQUAL "unkeyed-link")
  SET(expected "Unkeyed Diagen link in explicit-ID resources")
 ELSEIF(mode STREQUAL "saved-id")
  SET(expected "Unknown Diagen saved topic ID")
 ELSEIF(mode STREQUAL "saved-index")
  SET(expected "Invalid Diagen saved answer index")
 ELSEIF(mode STREQUAL "ambiguous-save")
  SET(expected "Ambiguous legacy Diagen saved topic")
 ELSE()
  SET(expected "Invalid Diagen topic ID")
 ENDIF()
 STRING(FIND "${stderr}" "${expected}" diagnostic)
 IF(NOT result STREQUAL "1" OR diagnostic LESS 0)
  MESSAGE(FATAL_ERROR "Diagen identity validation ${mode}: ${result}: ${stdout}\n${stderr}")
 ENDIF()
ENDFOREACH()
