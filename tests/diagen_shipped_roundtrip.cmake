FILE(MAKE_DIRECTORY "${TEST_ROOT}")
FILE(GLOB common "${SOURCE_ROOT}/*.dil" "${SOURCE_ROOT}/room.lst")
FOREACH(language ru en)
 SET(dir "${TEST_ROOT}/${language}")
 # Fresh input directories prevent removed source files surviving from an earlier run.
 STRING(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
 SET(stage "${dir}/source-${nonce}")
 FILE(MAKE_DIRECTORY "${stage}/data")
 FILE(COPY ${common} "${SOURCE_ROOT}/${language}" DESTINATION "${stage}/data")
 EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" pack "${language}"
  WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
 IF(NOT result STREQUAL "0")
  MESSAGE(FATAL_ERROR "Shipped Diagen source ${language}: ${result}: ${stdout}\n${stderr}")
 ENDIF()
 FILE(COPY_FILE "${stage}/diagen_new.text" "${dir}/diagen_new.text")
 IF(language STREQUAL "ru")
  SET(archive diagen.text)
 ELSE()
  SET(archive diagen_eng.text)
 ENDIF()
 IF(NOT DEFINED VERIFY_ARCHIVES OR VERIFY_ARCHIVES)
  EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E compare_files
   "${dir}/diagen_new.text" "${ARCHIVE_ROOT}/${archive}" RESULT_VARIABLE different)
  IF(different)
   MESSAGE(FATAL_ERROR "Stale ${archive}. Review and copy ${dir}/diagen_new.text to ${ARCHIVE_ROOT}/${archive}.")
  ENDIF()
 ENDIF()
 MESSAGE(STATUS "Rebuilt ${archive}: ${dir}/diagen_new.text")
ENDFOREACH()
