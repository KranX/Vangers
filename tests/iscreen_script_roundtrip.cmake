FILE(MAKE_DIRECTORY "${TEST_ROOT}")
STRING(ASCII 240 166 legacy_text)
SET(unicode_text "Ёж 日本 😀")
SET(keyed_text "@l10n:menu.iSTR_NEW_GAME")
FOREACH(encoding unicode legacy keyed)
	SET(text "${${encoding}_text}")
	SET(flag "")
	IF(encoding STREQUAL "unicode")
		SET(flag "utf8_text\n")
	ENDIF()
	# FILE(WRITE) uses text mode on Windows: explicit CRLF would become CRCRLF.
	# Native LF/CRLF both describe three lines, with no final terminator.
	SET(body_text "${text}")
	SET(resource "${encoding}.txt")
	IF(encoding STREQUAL "keyed")
		SET(body_text "NEW GAME")
		FILE(MAKE_DIRECTORY "${TEST_ROOT}/resource/iscreen/text/eng")
		FILE(WRITE "${TEST_ROOT}/resource/iscreen/text/eng/credits1.txt" "${body_text}\n\n${body_text}")
		SET(resource "@resource:credits.A")
	ENDIF()
	FILE(WRITE "${TEST_ROOT}/${encoding}.txt" "${body_text}\n\n${body_text}")
	FILE(WRITE "${TEST_ROOT}/${encoding}.inc" "text_object 1 \"${text}\" \"${resource}\"\nScreen \"screen\" {\ndefault_obj \"obj\"\nObject \"obj\" {\nprompt_text \"${text}\"\ntext \"${resource}\"\ns_text \"${resource}\"\nElement STRING {\nid \"large\"\nstring \"${text}\"\n}\nElement S_STRING {\nstring \"${text}\"\n}\n}\n}\ndefault_scr \"screen\"\n")
	FILE(WRITE "${TEST_ROOT}/${encoding}.scr" "${flag}#include \"${encoding}.inc\"\n")
	FOREACH(mode source binary)
		IF(mode STREQUAL "source")
			SET(parser "${SOURCE_PARSER}")
			SET(input "${encoding}.scr")
		ELSE()
			SET(parser "${BINARY_PARSER}")
			SET(input "${encoding}.scb")
		ENDIF()
		EXECUTE_PROCESS(COMMAND "${parser}" --parse "${input}" "${encoding}.scb" "${encoding}"
			WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
		IF(NOT result STREQUAL "0")
			MESSAGE(FATAL_ERROR "iscreen ${encoding} ${mode}: ${result}: ${stdout}\n${stderr}")
		ENDIF()
	ENDFOREACH()
	FILE(READ "${TEST_ROOT}/${encoding}.inc" flow_inc)
	STRING(REPLACE "Screen \"screen\"" "text_flow 0\nScreen \"screen\"" flow_inc "${flow_inc}")
	FILE(WRITE "${TEST_ROOT}/flow-${encoding}.inc" "${flow_inc}")
	FILE(WRITE "${TEST_ROOT}/flow-${encoding}.scr" "${flag}text_flow 240\n#include \"flow-${encoding}.inc\"\n")
	FOREACH(mode source binary)
		IF(mode STREQUAL "source")
			SET(parser "${SOURCE_PARSER}")
			SET(input "flow-${encoding}.scr")
		ELSE()
			SET(parser "${BINARY_PARSER}")
			SET(input "flow-${encoding}.scb")
		ENDIF()
		EXECUTE_PROCESS(COMMAND "${parser}" --parse "${input}" "flow-${encoding}.scb" "${encoding}" flow
			WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
		IF(NOT result STREQUAL "0")
			MESSAGE(FATAL_ERROR "iscreen ${encoding} ${mode}: ${result}: ${stdout}\n${stderr}")
		ENDIF()
	ENDFOREACH()
ENDFOREACH()

# An explicit UTF-8 include must not silently reinterpret legacy bytes.
FILE(WRITE "${TEST_ROOT}/invalid.scr" "utf8_text\n#include \"legacy.inc\"\n")
EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
	"${SOURCE_PARSER}" --parse invalid.scr invalid.scb unicode
	WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result ERROR_VARIABLE stderr OUTPUT_VARIABLE stdout)
STRING(FIND "${stderr}" "Invalid iscreen display text" diagnostic)
STRING(FIND "${stderr}" "invalid.scr: option text_object" context)
IF(NOT result STREQUAL "1" OR diagnostic LESS 0 OR context LESS 0)
	MESSAGE(FATAL_ERROR "Invalid resource lost its diagnostic (${result}): ${stdout}\n${stderr}")
ENDIF()

FOREACH(width -1 801)
 FILE(WRITE "${TEST_ROOT}/invalid-flow.scr" "text_flow ${width}\n")
 EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
  "${SOURCE_PARSER}" --parse invalid-flow.scr invalid-flow.scb unicode
  WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result ERROR_VARIABLE stderr OUTPUT_VARIABLE stdout TIMEOUT 10)
 STRING(FIND "${stderr}" "Invalid text_flow width" diagnostic)
 IF(NOT result STREQUAL "1" OR diagnostic LESS 0)
  MESSAGE(FATAL_ERROR "Invalid text_flow width accepted (${result}): ${stdout}\n${stderr}")
 ENDIF()
ENDFOREACH()

# All resource-marker entry points must use the normal contextual parser error.
FOREACH(option text_object text s_text)
 SET(body "text_object 1 \"Caption\" \"@resource:history.typo\"\n")
 IF(NOT option STREQUAL "text_object")
  SET(body "Screen \"screen\" {\nObject \"obj\" {\n${option} \"@resource:history.typo\"\n}\n}\n")
 ENDIF()
 SET(input "bad-resource-${option}.scr")
 FILE(WRITE "${TEST_ROOT}/${input}" "${body}")
 EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
  "${SOURCE_PARSER}" --parse "${input}" "bad-resource-${option}.scb" keyed
  WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
 FOREACH(expected "Invalid iscreen text resource" "${input}: option ${option}" "history.typo" "ERROR_DIALOG:")
  STRING(FIND "${stderr}" "${expected}" position)
  IF(NOT result STREQUAL "1" OR position LESS 0)
   MESSAGE(FATAL_ERROR "Missing resource context '${expected}': ${result}: ${stdout}\n${stderr}")
  ENDIF()
 ENDFOREACH()
ENDFOREACH()
# A valid SCB can also reference a role omitted from a broken baseline manifest.
FILE(MAKE_DIRECTORY "${TEST_ROOT}/bad-catalog")
FILE(COPY "$ENV{VANGERS_LOCALES}/en" DESTINATION "${TEST_ROOT}/bad-catalog")
FILE(READ "${TEST_ROOT}/bad-catalog/en/manifest.toml" manifest)
STRING(REGEX REPLACE "\"credits[.]A\" = [^\n]*\n" "" manifest "${manifest}")
FILE(WRITE "${TEST_ROOT}/bad-catalog/en/manifest.toml" "${manifest}")
EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:detect_leaks=0"
 "VANGERS_LOCALES=${TEST_ROOT}/bad-catalog"
 "${BINARY_PARSER}" --parse keyed.scb unused.scb keyed
 WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
FOREACH(expected "Invalid iscreen text resource" "keyed.scb: option text_object" "credits.A" "ERROR_DIALOG:")
 STRING(FIND "${stderr}" "${expected}" position)
 IF(NOT result STREQUAL "1" OR position LESS 0)
  MESSAGE(FATAL_ERROR "Missing SCB resource context '${expected}': ${result}: ${stdout}\n${stderr}")
 ENDIF()
ENDFOREACH()
