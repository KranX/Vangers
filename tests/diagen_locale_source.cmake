STRING(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
SET(stage "${TEST_ROOT}/third-${nonce}")
FILE(MAKE_DIRECTORY "${stage}/data/zz-test")
FILE(GLOB common "${SOURCE_ROOT}/*.dil" "${SOURCE_ROOT}/room.lst")
FILE(COPY ${common} DESTINATION "${stage}/data")
# A third authoring directory, sharing scenarios, archive layout and all UI geometry.
FILE(COPY "${SOURCE_ROOT}/en" DESTINATION "${stage}/data")
FILE(COPY "${SOURCE_ROOT}/en/Inventory.text" DESTINATION "${stage}/data/zz-test")
EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" pack zz-test
 WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
IF(NOT result STREQUAL "0")
 MESSAGE(FATAL_ERROR "Third-locale authoring failed: ${result}: ${stdout}\n${stderr}")
ENDIF()
EXECUTE_PROCESS(COMMAND "${CMAKE_COMMAND}" -E compare_files
 "${stage}/diagen_new.text" "${ENGLISH_ARCHIVE}" RESULT_VARIABLE different)
IF(different)
 MESSAGE(FATAL_ERROR "A third locale changed scenario data or logical archive entry keys")
ENDIF()
STRING(FIND "${stderr}" "missing Diagen source" diagnostic)
IF(diagnostic LESS 0)
 MESSAGE(FATAL_ERROR "Missing localized source files were not diagnosed")
ENDIF()
# An actual override, not a locale ID which silently keeps reading English.
FILE(READ "${stage}/data/zz-test/Inventory.text" inventory)
STRING(FIND "${inventory}" "\"" quote)
MATH(EXPR start "${quote} + 1")
STRING(SUBSTRING "${inventory}" 0 ${start} before)
STRING(SUBSTRING "${inventory}" ${start} -1 after)
FILE(WRITE "${stage}/data/zz-test/Inventory.text" "${before}THIRD LOCALE TEST ${after}")
EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" pack zz-test
 WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
IF(NOT result STREQUAL "0")
 MESSAGE(FATAL_ERROR "Third-locale override failed: ${result}: ${stdout}\n${stderr}")
ENDIF()
FILE(READ "${stage}/diagen_new.text" archive HEX)
STRING(HEX "THIRD LOCALE TEST" marker)
STRING(FIND "${archive}" "${marker}" found)
IF(found LESS 0)
 MESSAGE(FATAL_ERROR "The compiler ignored the third-locale text override")
ENDIF()
