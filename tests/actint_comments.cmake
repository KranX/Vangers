FILE(MAKE_DIRECTORY "${TEST_ROOT}")
FILE(COPY "${ITEMS}" DESTINATION "${TEST_ROOT}")
FILE(STRINGS "${ITEMS}" definitions REGEX "^#define ITM[0-9]+_COMMENTS1 comments 1")
FOREACH(profile 1 2)
 SET(body "#include \"items.inc\"\n")
 FOREACH(def IN LISTS definitions)
  STRING(REGEX MATCH "ITM[0-9]+" item "${def}")
  STRING(APPEND body "invItem ${item} {\n$${item}_COMMENTS${profile}\n}\n")
 ENDFOREACH()
 FILE(WRITE "${TEST_ROOT}/profile${profile}.scr" "${body}")
 FOREACH(locale en ru)
  EXECUTE_PROCESS(COMMAND "${SOURCE_PARSER}" --comments "profile${profile}.scr" "profile${profile}.scb" "${locale}"
   WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  IF(NOT result STREQUAL "0")
   MESSAGE(FATAL_ERROR "Source profile${profile} ${locale}: ${result}: ${stdout}\n${stderr}")
  ENDIF()
  EXECUTE_PROCESS(COMMAND "${BINARY_PARSER}" --comments "profile${profile}.scb" unused.scb "${locale}"
   WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  IF(NOT result STREQUAL "0")
   MESSAGE(FATAL_ERROR "SCB profile${profile} ${locale}: ${result}: ${stdout}\n${stderr}")
  ENDIF()
 ENDFOREACH()
ENDFOREACH()
